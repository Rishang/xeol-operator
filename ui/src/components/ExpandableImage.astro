---
// A diagram that opens in a full-screen dialog with zoom controls (Esc or a click outside closes it).
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
}
const { src, alt } = Astro.props;
---

<figure class="xo-expandable not-content">
	<button type="button" class="xo-open" aria-label="Expand diagram" title="Expand diagram">
		<img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" />
		<span class="xo-hint" aria-hidden="true">⤢ Expand</span>
	</button>
	<dialog class="xo-dialog" aria-label={alt}>
		<div class="xo-toolbar">
			<button type="button" data-zoom="out" aria-label="Zoom out">−</button>
			<button type="button" data-zoom="reset" aria-label="Reset zoom">100%</button>
			<button type="button" data-zoom="in" aria-label="Zoom in">+</button>
			<button type="button" data-zoom="close" aria-label="Close">✕</button>
		</div>
		<div class="xo-scroll">
			<img src={src.src} width={src.width} height={src.height} alt={alt} />
		</div>
	</dialog>
</figure>

<script>
	document.querySelectorAll<HTMLElement>('.xo-expandable').forEach((root) => {
		const dialog = root.querySelector('dialog')!;
		const big = dialog.querySelector<HTMLImageElement>('.xo-scroll img')!;
		const label = dialog.querySelector<HTMLElement>('[data-zoom="reset"]')!;
		const base = Number(big.getAttribute('width'));
		let scale = 1;

		const apply = (next: number) => {
			scale = Math.min(4, Math.max(0.25, next));
			big.style.width = `${Math.round(base * scale)}px`;
			label.textContent = `${Math.round(scale * 100)}%`;
		};

		root.querySelector('.xo-open')!.addEventListener('click', () => {
			dialog.showModal();
			// Start fitted to the window width, never above 100%.
			apply(Math.min(1, (window.innerWidth - 48) / base));
		});
		dialog.querySelector('.xo-toolbar')!.addEventListener('click', (e) => {
			const action = (e.target as HTMLElement).closest<HTMLElement>('[data-zoom]')?.dataset.zoom;
			if (action === 'in') apply(scale * 1.25);
			else if (action === 'out') apply(scale / 1.25);
			else if (action === 'reset') apply(1);
			else if (action === 'close') dialog.close();
		});
		// A click on the backdrop targets the dialog element itself.
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
	});
</script>

<style>
	.xo-expandable {
		margin: 1.5rem 0;
	}
	.xo-open {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: #fff;
		cursor: zoom-in;
		overflow: hidden;
	}
	.xo-open img {
		display: block;
		width: 100%;
		height: auto;
	}
	.xo-hint {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		padding: 0.2rem 0.6rem;
		border-radius: 6px;
		background: rgba(27, 27, 31, 0.8);
		color: #fff;
		font-size: var(--sl-text-xs);
	}
	.xo-dialog {
		width: 100vw;
		max-width: 100vw;
		height: 100vh;
		max-height: 100vh;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(0, 0, 0, 0.7);
	}
	.xo-dialog[open] {
		display: flex;
		flex-direction: column;
	}
	.xo-dialog::backdrop {
		background: rgba(0, 0, 0, 0.7);
	}
	.xo-toolbar {
		display: flex;
		gap: 0.5rem;
		justify-content: flex-end;
		padding: 0.75rem 1rem;
	}
	.xo-toolbar button {
		min-width: 2.5rem;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 6px;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.xo-toolbar button:hover {
		border-color: var(--sl-color-accent);
	}
	.xo-scroll {
		flex: 1;
		overflow: auto;
		padding: 0 1.5rem 1.5rem;
	}
	.xo-scroll img {
		display: block;
		max-width: none;
		margin: 0 auto;
		background: #fff;
		border-radius: 8px;
	}
</style>
